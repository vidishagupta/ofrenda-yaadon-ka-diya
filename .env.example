# AI Configuration (OpenAI-compatible endpoint)
# Default is local Ollama running Gemma
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=gemma2:9b
AI_API_KEY=ollama

# Server Port
PORT=3000

# Examples for Hosted Open-Weight Providers (e.g. for Render deployment):
#
# Groq (Llama / Gemma open weights):
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=gemma2-9b-it
# AI_API_KEY=gsk_your_groq_api_key_here
#
# OpenRouter (Open-weight Gemma / Mistral):
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=google/gemma-2-9b-it:free
# AI_API_KEY=sk-or-v1-your_openrouter_api_key_here
#
# Together AI:
# AI_BASE_URL=https://api.together.xyz/v1
# AI_MODEL=google/gemma-2-9b-it
# AI_API_KEY=your_together_api_key_here

